generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AcademicYear {
  id        String    @id
  nameAr    String
  nameEn    String
  code      String    @unique
  order     Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime
  Subject   Subject[]
  User      User[]
}

model Badge {
  id            String   @id
  slug          String   @unique
  nameAr        String
  nameEn        String
  descriptionAr String
  descriptionEn String
  icon          String
  color         String
  requirement   Int
  type          String
  createdAt     DateTime @default(now())
}

model Concept {
  id           String @id
  lessonId     String
  termAr       String
  termEn       String
  definitionAr String
  definitionEn String
  order        Int    @default(1)
  Lesson       Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Example {
  id         String @id
  lessonId   String
  questionAr String
  questionEn String
  solutionAr String
  solutionEn String
  stepsAr    String
  stepsEn    String
  order      Int    @default(1)
  Lesson     Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Formula {
  id            String @id
  lessonId      String
  formula       String
  explanationAr String
  explanationEn String
  order         Int    @default(1)
  Lesson        Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Infographic {
  id       String @id
  lessonId String @unique
  type     String
  data     String
}

model Lesson {
  id              String            @id
  unitId          String
  titleAr         String
  titleEn         String
  slug            String            @unique
  descriptionAr   String
  descriptionEn   String
  duration        Int
  order           Int               @default(1)
  isFree          Boolean           @default(false)
  videoUrl        String?
  pdfUrl          String?
  thumbnailUrl    String?
  introductionAr  String
  introductionEn  String
  summaryAr       String
  summaryEn       String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  Concept         Concept[]
  Example         Example[]
  Formula         Formula[]
  Unit            Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  LessonSimulator LessonSimulator[]
  Objective       Objective[]
  Progress        Progress[]
  Question        Question[]
  QuizResult      QuizResult[]
}

model LessonSimulator {
  id          String    @id
  lessonId    String
  simulatorId String
  Lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  Simulator   Simulator @relation(fields: [simulatorId], references: [id], onDelete: Cascade)

  @@unique([lessonId, simulatorId])
}

model MindMap {
  id       String @id
  lessonId String @unique
  data     String
}

model Objective {
  id       String @id
  lessonId String
  textAr   String
  textEn   String
  order    Int    @default(1)
  Lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Progress {
  id        String    @id
  userId    String
  lessonId  String
  completed Boolean   @default(false)
  score     Int?
  timeSpent Int       @default(0)
  watchedAt DateTime?
  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  Lesson    Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Question {
  id            String  @id
  lessonId      String
  type          String
  questionAr    String
  questionEn    String
  optionsAr     String?
  optionsEn     String?
  answer        String
  explanationAr String?
  explanationEn String?
  points        Int     @default(1)
  difficulty    String  @default("medium")
  order         Int     @default(1)
  Lesson        Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model QuizResult {
  id          String   @id
  userId      String
  lessonId    String
  score       Int
  totalPoints Int
  answers     String
  completedAt DateTime @default(now())
  User        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  Lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Semester {
  id        String   @id
  nameAr    String
  nameEn    String
  code      String   @unique
  order     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime
  Unit      Unit[]
}

model Simulator {
  id              String            @id
  nameAr          String
  nameEn          String
  slug            String            @unique
  type            String
  descriptionAr   String
  descriptionEn   String
  icon            String?
  difficulty      String            @default("intermediate")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  LessonSimulator LessonSimulator[]
}

model Specialization {
  id            String    @id
  nameAr        String
  nameEn        String
  code          String    @unique
  descriptionAr String?
  descriptionEn String?
  order         Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
  Subject       Subject[]
  User          User[]
}

model Subject {
  id               String          @id
  nameAr           String
  nameEn           String
  slug             String          @unique
  icon             String
  color            String
  order            Int             @default(1)
  yearId           String?
  specializationId String?
  isCommon         Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime
  AcademicYear     AcademicYear?   @relation(fields: [yearId], references: [id])
  Specialization   Specialization? @relation(fields: [specializationId], references: [id])
  Unit             Unit[]
}

model Unit {
  id         String    @id
  subjectId  String
  semesterId String?
  nameAr     String
  nameEn     String
  slug       String    @unique
  order      Int       @default(1)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime
  Lesson     Lesson[]
  Subject    Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  Semester   Semester? @relation(fields: [semesterId], references: [id])
}

model User {
  id               String          @id
  email            String          @unique
  name             String
  password         String?
  role             String          @default("student")
  yearId           String?
  specializationId String?
  isSubscribed     Boolean         @default(false)
  points           Int             @default(0)
  level            String          @default("beginner")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime
  Progress         Progress[]
  QuizResult       QuizResult[]
  AcademicYear     AcademicYear?   @relation(fields: [yearId], references: [id])
  Specialization   Specialization? @relation(fields: [specializationId], references: [id])
  UserBadge        UserBadge[]
}

model UserBadge {
  id        String   @id
  userId    String
  badgeSlug String
  earnedAt  DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeSlug])
}

// ============ Book Extraction System ============

model Book {
  id          String     @id
  title       String
  fileName    String
  filePath    String
  fileSize    Int        @default(0)
  totalPages  Int        @default(0)
  language    String     @default("ar")
  status      String     @default("uploaded") // uploaded | extracting | extracted | processing | completed | error
  progress    Int        @default(0)
  error       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime
  BookPage    BookPage[]
  ExtractedUnit ExtractedUnit[]
}

model BookPage {
  id        String  @id
  bookId    String
  pageNumber Int
  ocrText   String  @default("")
  status    String  @default("pending") // pending | processing | done | error
  createdAt DateTime @default(now())
  updatedAt DateTime
  Book      Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, pageNumber])
}

model ExtractedUnit {
  id          String            @id
  bookId      String
  unitNumber  Int
  titleAr     String
  titleEn     String
  description String            @default("")
  order       Int               @default(1)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime
  Book        Book              @relation(fields: [bookId], references: [id], onDelete: Cascade)
  ExtractedLesson ExtractedLesson[]
}

model ExtractedLesson {
  id          String           @id
  unitId      String
  lessonNumber Int
  titleAr     String
  titleEn     String
  content     String           @default("")
  summary     String           @default("")
  keyPoints   String           @default("[]") // JSON array
  order       Int              @default(1)
  status      String           @default("draft") // draft | reviewed | approved
  createdAt   DateTime         @default(now())
  updatedAt   DateTime
  ExtractedUnit ExtractedUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
}
